# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=petcare

# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-esta-clave-por-una-secreta-y-aleatoria

# Frontend servido en el mismo origen o desde este origen permitido
CORS_ORIGINS=http://localhost:8080

# true solo con HTTPS; false para desarrollo local HTTP
COOKIE_SECURE=false

# Cuentas iniciales creadas por setup_database.py (solo desarrollo)
ADMIN_EMAIL=admin@petcare.com
ADMIN_PASSWORD=Admin123!
USER_EMAIL=usuario@petcare.com
USER_PASSWORD=Usuario123!
